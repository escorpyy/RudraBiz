{
  "name": "@ntcas/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "db:pull": "drizzle-kit pull",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "tsx --env-file=../../.env src/server.ts"
  },
  "dependencies": {
    "@ntcas/shared": "*",
    "cors": "^2.8.5",
    "drizzle-orm": "0.38.3",
    "express": "^5.1.0",
    "pg": "8.13.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "22.10.7",
    "@types/pg": "8.11.10",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "0.30.1",
    "supertest": "^7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
