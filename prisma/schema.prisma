generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum GLType {
  CUSTOMER
  VENDOR
  BOTH
  OTHER
}

enum AuditAction {
  INSERT
  UPDATE
  DELETE
}

enum DocumentType {
  CASH_BANK_VOUCHER
  JOURNAL_VOUCHER
  SALES_INVOICE
  PURCHASE_BILL
}

enum InstrumentType {
  CHEQUE
  RTGS
  ONLINE_TRANSFER
  OTHER
}

// ============================================================
// CHART OF ACCOUNTS
// ============================================================

model AccountGroup {
  id          Int         @id @default(autoincrement())
  code        String      @unique @db.VarChar(10)
  description String      @unique @db.VarChar(50)
  type        AccountType
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  subGroups   AccountSubGroup[]
}

model AccountSubGroup {
  id             Int          @id @default(autoincrement())
  code           String       @db.VarChar(10)
  description    String       @db.VarChar(50)
  accountGroupId Int
  accountGroup   AccountGroup @relation(fields: [accountGroupId], references: [id], onDelete: Restrict)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  generalLedgers GeneralLedger[]

  @@unique([accountGroupId, code])
  @@unique([accountGroupId, description])
}

// ============================================================
// GENERAL LEDGER (formerly "Account")
// ============================================================

model GeneralLedger {
  id                Int             @id @default(autoincrement())
  code              String          @unique @db.VarChar(20)
  name              String          @db.VarChar(100)
  accountSubGroupId Int
  accountSubGroup   AccountSubGroup @relation(fields: [accountSubGroupId], references: [id], onDelete: Restrict)
  normalBalance     NormalBalance
  glType            GLType          @default(OTHER)

  parentId          Int?
  parent            GeneralLedger?  @relation("GLHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children          GeneralLedger[] @relation("GLHierarchy")

  isCashOrBank      Boolean         @default(false)
  postsToCashBook   Boolean         @default(false)
  requiresSubLedger Boolean         @default(false)
  allowDocAdjust    Boolean         @default(false)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  party             Party?

  subAreaId         Int?
  subArea           SubArea?        @relation(fields: [subAreaId], references: [id], onDelete: SetNull)
  agentId           Int?
  agent             Agent?          @relation(fields: [agentId], references: [id], onDelete: SetNull)

  // Dimension tables (Cash Flow, Working Capital, Cost Behavior, Decision Areas)
  // are intentionally paused — they depend on JournalEntry/JournalLine
  // existing first. Revisit after the transactional core is built.

  journalVoucherLines  JournalVoucherLine[]
  cashBankVoucherLines CashBankVoucherLine[]

  subLedgers        SubLedger[]

  // Product-catalog GL linkages — one array field per named relation
  // on StockDetail/NonStockDetail/ServiceDetail/FixedAssetDetail/BundleDetail.
  // Kept as separate relations (not a single generic FK) because each
  // represents a distinct accounting role a GL can play for a product.
  stockOpeningFor            StockDetail[]      @relation("StockOpeningGL")
  stockClosingPLFor          StockDetail[]      @relation("StockClosingPLGL")
  stockClosingBSFor          StockDetail[]      @relation("StockClosingBSGL")
  stockPurchaseFor           StockDetail[]      @relation("StockPurchaseGL")
  stockPurchaseReturnFor     StockDetail[]      @relation("StockPurchaseReturnGL")
  stockSalesFor              StockDetail[]      @relation("StockSalesGL")
  stockSalesReturnFor        StockDetail[]      @relation("StockSalesReturnGL")
  nonStockSalesFor           NonStockDetail[]   @relation("NonStockSalesGL")
  nonStockPurchaseFor        NonStockDetail[]   @relation("NonStockPurchaseGL")
  serviceSalesFor            ServiceDetail[]    @relation("ServiceSalesGL")
  servicePurchaseFor         ServiceDetail[]    @relation("ServicePurchaseGL")
  fixedAssetFor              FixedAssetDetail[] @relation("FixedAssetGL")
  fixedAssetAccumDeprFor     FixedAssetDetail[] @relation("FixedAssetAccumDeprGL")
  fixedAssetDeprExpenseFor   FixedAssetDetail[] @relation("FixedAssetDeprExpenseGL")
  bundleSalesFor             BundleDetail[]     @relation("BundleSalesGL")

  @@index([accountSubGroupId])
  @@index([parentId])
  @@index([glType])
  @@index([subAreaId])
  @@index([agentId])
}

// ============================================================
// AREA & SUB AREA (final)
// Area is the top-level region; SubArea is the level that
// GeneralLedger/Party actually tag against — same Group/SubGroup
// pattern as the Chart of Accounts. Agent is a separate,
// independent lookup (DRAFT — full 5-category pass not yet done).
// ============================================================

model Area {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(10)
  name      String   @unique @db.VarChar(50)
  shortName String   @unique @db.VarChar(10)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subAreas  SubArea[]
}

model SubArea {
  id        Int      @id @default(autoincrement())
  code      String   @db.VarChar(10)
  name      String   @db.VarChar(50)
  shortName String   @db.VarChar(10)
  areaId    Int
  area      Area     @relation(fields: [areaId], references: [id], onDelete: Restrict)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  generalLedgers GeneralLedger[]
  parties        Party[]

  @@unique([areaId, code])
  @@unique([areaId, name])
  @@unique([areaId, shortName])
}

model Agent {
  id             Int             @id @default(autoincrement())
  code           String          @unique @db.VarChar(10)
  name           String          @db.VarChar(100)
  phone          String?         @db.VarChar(25)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  generalLedgers GeneralLedger[]
  parties        Party[]
  journalVoucherLines  JournalVoucherLine[]
  cashBankVoucherLines CashBankVoucherLine[]
}

// ============================================================
// PARTY (DRAFT — full 5-category pass not yet done)
// ============================================================

model Party {
  id                Int             @id @default(autoincrement())
  generalLedgerId   Int             @unique
  generalLedger     GeneralLedger   @relation(fields: [generalLedgerId], references: [id], onDelete: Cascade)

  address           String?         @db.VarChar(255)
  city              String?         @db.VarChar(50)
  state             String?         @db.VarChar(50)
  country           String?         @db.VarChar(50)
  phone             String?         @db.VarChar(25)
  mobile            String?         @db.VarChar(15)
  email             String?         @db.VarChar(255)
  contactPerson     String?         @db.VarChar(50)

  panNo             String?         @unique @db.VarChar(25)
  isVatRegistered   Boolean         @default(false)

  bankReconcileDate DateTime?

  subAreaId         Int?
  subArea           SubArea?        @relation(fields: [subAreaId], references: [id], onDelete: SetNull)
  agentId           Int?
  agent             Agent?          @relation(fields: [agentId], references: [id], onDelete: SetNull)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  customerDetail    CustomerDetail?
  vendorDetail      VendorDetail?

  subLedgers        SubLedger[]

  stockDefaultVendorFor StockDetail[] @relation("StockDefaultVendor")

  @@index([panNo])
  @@index([subAreaId])
  @@index([agentId])
}

// ============================================================
// SUB LEDGER
// A finer-grained posting account nested under a General Ledger
// and/or tied to a Party — used where a GL has
// `requiresSubLedger` set and postings need to track detail
// below the GL level (e.g. per-party or per-scheme balances).
// ============================================================

model SubLedger {
  id              Int            @id @default(autoincrement())
  code            String         @unique @db.VarChar(20)
  name            String         @db.VarChar(100)

  generalLedgerId Int?
  generalLedger   GeneralLedger? @relation(fields: [generalLedgerId], references: [id], onDelete: Restrict)

  partyId         Int?
  party           Party?         @relation(fields: [partyId], references: [id], onDelete: Restrict)

  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([generalLedgerId])
  @@index([partyId])
}

model CustomerDetail {
  id          Int      @id @default(autoincrement())
  partyId     Int      @unique
  party       Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)

  creditLimit Decimal? @db.Decimal(18, 6)
  creditDays  Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VendorDetail {
  id              Int      @id @default(autoincrement())
  partyId         Int      @unique
  party           Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)

  paymentTermDays Int?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================
// JOURNAL VOUCHER (non-cash/bank entries)
// ============================================================

model JournalVoucher {
  id            Int                  @id @default(autoincrement())
  documentType  DocumentType         @default(JOURNAL_VOUCHER)
  voucherNumber String               @unique @db.VarChar(30)
  voucherDate   DateTime             @db.Date
  fiscalYear    String               @db.VarChar(15)
  remarks       String?              @db.VarChar(1024)

  reversalOfId  Int?
  reversalOf    JournalVoucher?      @relation("JVReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy    JournalVoucher[]     @relation("JVReversal")

  isPosted      Boolean              @default(false)
  postedAt      DateTime?
  postedBy      Int?
  postedByUser  User?                @relation("JVPostedBy", fields: [postedBy], references: [id], onDelete: SetNull)

  createdBy     Int?
  createdByUser User?                @relation("JVCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  lines         JournalVoucherLine[]

  @@index([documentType])
  @@index([fiscalYear])
}

model JournalVoucherLine {
  id               Int            @id @default(autoincrement())
  journalVoucherId Int
  journalVoucher   JournalVoucher @relation(fields: [journalVoucherId], references: [id], onDelete: Cascade)

  lineNumber       Int
  generalLedgerId  Int
  generalLedger    GeneralLedger  @relation(fields: [generalLedgerId], references: [id], onDelete: Restrict)

  debit            Decimal        @default(0) @db.Decimal(18, 6)
  credit           Decimal        @default(0) @db.Decimal(18, 6)
  narration        String?        @db.VarChar(500)

  agentId          Int?
  agent            Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)

  createdAt        DateTime       @default(now())

  @@unique([journalVoucherId, lineNumber])
  @@index([generalLedgerId])
  @@index([agentId])
}

// ============================================================
// CASH / BANK VOUCHER (cash and bank-touching entries)
// ============================================================

model CashBankVoucher {
  id            Int                    @id @default(autoincrement())
  documentType  DocumentType           @default(CASH_BANK_VOUCHER)
  voucherNumber String                 @unique @db.VarChar(30)
  voucherDate   DateTime               @db.Date
  fiscalYear    String                 @db.VarChar(15)
  remarks       String?                @db.VarChar(1024)

  reversalOfId  Int?
  reversalOf    CashBankVoucher?       @relation("CBReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy    CashBankVoucher[]      @relation("CBReversal")

  isPosted      Boolean                @default(false)
  postedAt      DateTime?
  postedBy      Int?
  postedByUser  User?                  @relation("CBPostedBy", fields: [postedBy], references: [id], onDelete: SetNull)

  createdBy     Int?
  createdByUser User?                  @relation("CBCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  lines         CashBankVoucherLine[]

  @@index([documentType])
  @@index([fiscalYear])
}

model CashBankVoucherLine {
  id                Int              @id @default(autoincrement())
  cashBankVoucherId Int
  cashBankVoucher   CashBankVoucher  @relation(fields: [cashBankVoucherId], references: [id], onDelete: Cascade)

  lineNumber        Int
  generalLedgerId   Int
  generalLedger     GeneralLedger    @relation(fields: [generalLedgerId], references: [id], onDelete: Restrict)

  debit             Decimal          @default(0) @db.Decimal(18, 6)
  credit            Decimal          @default(0) @db.Decimal(18, 6)
  narration         String?          @db.VarChar(500)

  instrumentType    InstrumentType?
  chequeNumber      String?          @db.VarChar(30)
  chequeDate        DateTime?        @db.Date
  chequeBankName    String?          @db.VarChar(50)
  chequeBankBranch  String?          @db.VarChar(50)

  isCleared         Boolean          @default(false)
  clearedDate       DateTime?        @db.Date
  clearedBy         Int?
  clearedByUser     User?            @relation("CBLineClearedBy", fields: [clearedBy], references: [id], onDelete: SetNull)

  agentId           Int?
  agent             Agent?           @relation(fields: [agentId], references: [id], onDelete: SetNull)

  createdAt         DateTime         @default(now())

  @@unique([cashBankVoucherId, lineNumber])
  @@index([generalLedgerId])
  @@index([agentId])
  @@index([chequeNumber])
}

// ============================================================
// USER (minimal — referenced by AuditLog)
// ============================================================

model User {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(255)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  auditLogs             AuditLog[]
  journalVouchersPosted  JournalVoucher[]      @relation("JVPostedBy")
  journalVouchersCreated JournalVoucher[]      @relation("JVCreatedBy")
  cashBankVouchersPosted  CashBankVoucher[]     @relation("CBPostedBy")
  cashBankVouchersCreated CashBankVoucher[]     @relation("CBCreatedBy")
  cashBankLinesCleared    CashBankVoucherLine[] @relation("CBLineClearedBy")
}

// ============================================================
// AUDIT LOG (generic, DB-trigger based)
// ============================================================

model AuditLog {
  id        BigInt      @id @default(autoincrement())
  tableName String      @db.VarChar(63)
  recordId  String
  action    AuditAction
  oldData   Json?
  newData   Json?
  changedBy Int?
  user      User?       @relation(fields: [changedBy], references: [id], onDelete: SetNull)
  changedAt DateTime    @default(now())

  @@index([tableName, recordId])
  @@index([changedAt])
}

// ============================================================
// PRODUCT CATALOG
// ============================================================
// Five product types share one Product "header" row plus a
// type-specific detail table (1:1, PK = FK, Cascade on delete of
// the header). Consistency between Product.type and "exactly one
// matching detail row" is not expressible in the Prisma schema
// language, so it's enforced by triggers in the migration SQL
// (fn_check_product_type_match / fn_check_product_single_detail).
// ============================================================

enum ProductType {
  STOCK
  NON_STOCK
  SERVICE
  FIXED_ASSET
  BUNDLE
}

enum ValuationMethod {
  FIFO
  WEIGHTED_AVERAGE
  STANDARD_COST
}

enum DepreciationMethod {
  STRAIGHT_LINE
  WRITTEN_DOWN_VALUE
}

// ------------------------------------------------------------
// PRODUCT GROUP / SUBGROUP — same Group/SubGroup pattern as
// AccountGroup/AccountSubGroup, for consistency across the schema.
// ------------------------------------------------------------

model ProductGroup {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(10)
  name      String   @unique @db.VarChar(50)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subGroups ProductSubGroup[]
}

model ProductSubGroup {
  id             Int          @id @default(autoincrement())
  code           String       @db.VarChar(10)
  name           String       @db.VarChar(50)
  productGroupId Int
  productGroup   ProductGroup @relation(fields: [productGroupId], references: [id], onDelete: Restrict)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  products       Product[]

  @@unique([productGroupId, code])
  @@unique([productGroupId, name])
}

// ------------------------------------------------------------
// PRODUCT UNIT — decimalPlaces matters practically: PCS should
// not accept 2.5, but KG/LTR should. Enforced at the app layer
// using this, plus a DB-level 0–6 sanity CHECK.
// ------------------------------------------------------------

model ProductUnit {
  id            Int      @id @default(autoincrement())
  code          String   @unique @db.VarChar(10) // "PCS", "KG", "BOX"
  name          String   @unique @db.VarChar(50)
  decimalPlaces Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  stockBaseFor     StockDetail[]    @relation("StockBaseUnit")
  nonStockUnitFor  NonStockDetail[] @relation("NonStockUnit")
  serviceUnitFor   ServiceDetail[]  @relation("ServiceUnit")
  alternateUnitFor AlternateUnit[]  @relation("AltUnit")
}

// ------------------------------------------------------------
// TAX RATE — every STOCK/NON_STOCK/SERVICE item needs a rate for
// invoicing & returns.
// ------------------------------------------------------------

model TaxRate {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(10)
  name        String   @db.VarChar(50) // "GST 13%", "VAT 5%"
  ratePercent Decimal  @db.Decimal(5, 2)
  hsnSacCode  String?  @db.VarChar(20) // HSN for goods, SAC for services
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stockDetails    StockDetail[]
  nonStockDetails NonStockDetail[]
  serviceDetails  ServiceDetail[]
}

// ------------------------------------------------------------
// STOCK CATEGORY & LOCATION
// ------------------------------------------------------------

model StockCategory {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(10)
  name      String   @unique @db.VarChar(50)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockDetails StockDetail[]
}

model Location {
  id   Int    @id @default(autoincrement())
  code String @unique @db.VarChar(10)
  name String @db.VarChar(50)

  parentId Int?
  parent   Location?  @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Location[] @relation("LocationHierarchy")

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockDetails      StockDetail[]      @relation("StockDefaultLocation")
  fixedAssetDetails FixedAssetDetail[] @relation("FixedAssetLocation")

  @@index([parentId])
}

// ------------------------------------------------------------
// PRODUCT — parent header for all five types
// ------------------------------------------------------------

model Product {
  id          Int          @id @default(autoincrement())
  code        String       @unique @db.VarChar(10)
  description String       @db.VarChar(256) // not globally unique — see ProductSubGroup note
  shortName   String?      @db.VarChar(30)
  barcode     String?      @unique @db.VarChar(64)
  type        ProductType

  productSubGroupId Int
  productSubGroup   ProductSubGroup @relation(fields: [productSubGroupId], references: [id], onDelete: Restrict)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockDetail      StockDetail?
  nonStockDetail   NonStockDetail?
  serviceDetail    ServiceDetail?
  fixedAssetDetail FixedAssetDetail?
  bundleDetail     BundleDetail?

  bundleComponentOf BundleComponent[] @relation("BundleComponentProduct")

  @@index([productSubGroupId])
  @@index([type])
  @@index([type, isActive])
  @@index([description])
}

// ------------------------------------------------------------
// STOCK DETAIL
// ------------------------------------------------------------

model StockDetail {
  id        Int     @id @default(autoincrement())
  productId Int     @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  baseUnitId Int
  baseUnit   ProductUnit @relation("StockBaseUnit", fields: [baseUnitId], references: [id], onDelete: Restrict)

  stockCategoryId Int?
  stockCategory   StockCategory? @relation(fields: [stockCategoryId], references: [id], onDelete: SetNull)

  defaultLocationId Int?
  defaultLocation   Location? @relation("StockDefaultLocation", fields: [defaultLocationId], references: [id], onDelete: SetNull)

  taxRateId Int?
  taxRate   TaxRate? @relation(fields: [taxRateId], references: [id], onDelete: SetNull)

  valuationMethod ValuationMethod @default(WEIGHTED_AVERAGE)
  tracksBatch     Boolean         @default(false)
  tracksExpiry    Boolean         @default(false)

  purchaseRate Decimal? @db.Decimal(18, 6)
  salesRate    Decimal? @db.Decimal(18, 6)
  mrp          Decimal? @db.Decimal(18, 6)
  tradePrice   Decimal? @db.Decimal(18, 6)

  minStock     Decimal? @db.Decimal(18, 6)
  maxStock     Decimal? @db.Decimal(18, 6)
  reorderLevel Decimal? @db.Decimal(18, 6)
  reorderQty   Decimal? @db.Decimal(18, 6)

  openingGLId   Int?
  openingGL     GeneralLedger? @relation("StockOpeningGL", fields: [openingGLId], references: [id], onDelete: SetNull)
  closingPLGLId Int?
  closingPLGL   GeneralLedger? @relation("StockClosingPLGL", fields: [closingPLGLId], references: [id], onDelete: SetNull)
  closingBSGLId Int?
  closingBSGL   GeneralLedger? @relation("StockClosingBSGL", fields: [closingBSGLId], references: [id], onDelete: SetNull)

  purchaseGLId       Int?
  purchaseGL         GeneralLedger? @relation("StockPurchaseGL", fields: [purchaseGLId], references: [id], onDelete: SetNull)
  purchaseReturnGLId Int?
  purchaseReturnGL   GeneralLedger? @relation("StockPurchaseReturnGL", fields: [purchaseReturnGLId], references: [id], onDelete: SetNull)
  salesGLId          Int?
  salesGL            GeneralLedger? @relation("StockSalesGL", fields: [salesGLId], references: [id], onDelete: SetNull)
  salesReturnGLId    Int?
  salesReturnGL      GeneralLedger? @relation("StockSalesReturnGL", fields: [salesReturnGLId], references: [id], onDelete: SetNull)

  defaultVendorId Int?
  defaultVendor   Party? @relation("StockDefaultVendor", fields: [defaultVendorId], references: [id], onDelete: SetNull)

  alternateUnits AlternateUnit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([baseUnitId])
  @@index([stockCategoryId])
  @@index([defaultLocationId])
  @@index([defaultVendorId])
  @@index([taxRateId])
  @@index([openingGLId])
  @@index([closingPLGLId])
  @@index([closingBSGLId])
  @@index([purchaseGLId])
  @@index([purchaseReturnGLId])
  @@index([salesGLId])
  @@index([salesReturnGLId])
}

// Flattened — one hop to base unit, no traversal, no cycle risk.
// 1 unit (e.g. Box) = conversionFactor * baseUnit (e.g. 12 Pcs).
// A trigger blocks unitId == the parent StockDetail's baseUnitId.
model AlternateUnit {
  id            Int         @id @default(autoincrement())
  stockDetailId Int
  stockDetail   StockDetail @relation(fields: [stockDetailId], references: [id], onDelete: Cascade)

  unitId Int
  unit   ProductUnit @relation("AltUnit", fields: [unitId], references: [id], onDelete: Restrict)

  conversionFactor Decimal @db.Decimal(18, 6)

  @@unique([stockDetailId, unitId])
  @@index([unitId])
}

// ------------------------------------------------------------
// NON-STOCK DETAIL — buy/sell, quantity not tracked
// ------------------------------------------------------------

model NonStockDetail {
  id        Int     @id @default(autoincrement())
  productId Int     @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  unitId Int
  unit   ProductUnit @relation("NonStockUnit", fields: [unitId], references: [id], onDelete: Restrict)

  taxRateId Int?
  taxRate   TaxRate? @relation(fields: [taxRateId], references: [id], onDelete: SetNull)

  salesGLId    Int
  salesGL      GeneralLedger @relation("NonStockSalesGL", fields: [salesGLId], references: [id], onDelete: Restrict)
  purchaseGLId Int
  purchaseGL   GeneralLedger @relation("NonStockPurchaseGL", fields: [purchaseGLId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId])
  @@index([taxRateId])
  @@index([salesGLId])
  @@index([purchaseGLId])
}

// ------------------------------------------------------------
// SERVICE DETAIL
// ------------------------------------------------------------

model ServiceDetail {
  id        Int     @id @default(autoincrement())
  productId Int     @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  unitId Int?
  unit   ProductUnit? @relation("ServiceUnit", fields: [unitId], references: [id], onDelete: SetNull)
  // usually "per hour"/"per visit" — optional since many services are lump-sum

  taxRateId Int?
  taxRate   TaxRate? @relation(fields: [taxRateId], references: [id], onDelete: SetNull)

  salesGLId    Int
  salesGL      GeneralLedger @relation("ServiceSalesGL", fields: [salesGLId], references: [id], onDelete: Restrict)
  purchaseGLId Int
  purchaseGL   GeneralLedger @relation("ServicePurchaseGL", fields: [purchaseGLId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId])
  @@index([taxRateId])
  @@index([salesGLId])
  @@index([purchaseGLId])
}

// ------------------------------------------------------------
// FIXED ASSET DETAIL — needs three GLs to actually work for
// depreciation accounting: the asset itself, accumulated
// depreciation (contra-asset, balance sheet), and depreciation
// expense (P&L). Without all three you can't post depreciation.
// A running accumulatedDepreciation total is kept for quick
// reference only — the authoritative trail should be a future
// depreciation schedule/posting table, deferred deliberately for now.
// ------------------------------------------------------------

model FixedAssetDetail {
  id        Int     @id @default(autoincrement())
  productId Int     @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  assetGLId               Int
  assetGL                 GeneralLedger @relation("FixedAssetGL", fields: [assetGLId], references: [id], onDelete: Restrict)
  accumulatedDeprGLId     Int
  accumulatedDeprGL       GeneralLedger @relation("FixedAssetAccumDeprGL", fields: [accumulatedDeprGLId], references: [id], onDelete: Restrict)
  depreciationExpenseGLId Int
  depreciationExpenseGL   GeneralLedger @relation("FixedAssetDeprExpenseGL", fields: [depreciationExpenseGLId], references: [id], onDelete: Restrict)

  locationId Int?
  location   Location? @relation("FixedAssetLocation", fields: [locationId], references: [id], onDelete: SetNull)

  purchaseDate    DateTime? @db.Date
  originalCost    Decimal?  @db.Decimal(18, 6)
  salvageValue    Decimal   @default(0) @db.Decimal(18, 6)
  usefulLifeYears Int?

  depreciationMethod      DepreciationMethod @default(STRAIGHT_LINE)
  depreciationRatePercent Decimal?           @db.Decimal(5, 2) // for WDV, or manual override

  accumulatedDepreciation Decimal @default(0) @db.Decimal(18, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId])
  @@index([assetGLId])
  @@index([accumulatedDeprGLId])
  @@index([depreciationExpenseGLId])
}

// ------------------------------------------------------------
// BUNDLE DETAIL + COMPONENTS
// A bundle's own components may not themselves be BUNDLE-type
// products (no nested bundles), and a bundle may not list itself
// as a component — both enforced by trigger, since they require
// cross-table lookups CHECK constraints can't express.
// ------------------------------------------------------------

model BundleDetail {
  id        Int     @id @default(autoincrement())
  productId Int     @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  salesGLId Int
  salesGL   GeneralLedger @relation("BundleSalesGL", fields: [salesGLId], references: [id], onDelete: Restrict)

  bundlePrice Decimal? @db.Decimal(18, 6) // override; else sum of components

  components BundleComponent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salesGLId])
}

model BundleComponent {
  id             Int          @id @default(autoincrement())
  bundleDetailId Int
  bundleDetail   BundleDetail @relation(fields: [bundleDetailId], references: [id], onDelete: Cascade)

  componentProductId Int
  componentProduct   Product @relation("BundleComponentProduct", fields: [componentProductId], references: [id], onDelete: Restrict)

  quantity Decimal @db.Decimal(18, 6)

  @@unique([bundleDetailId, componentProductId])
  @@index([componentProductId])
}
